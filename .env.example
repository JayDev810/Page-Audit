# Google PageSpeed Insights API Keys (Get from https://developers.google.com/speed/docs/insights/v5/get-started)
PSI_API_KEY_PRIMARY=your_primary_pagespeed_api_key_here
PSI_API_KEY_FALLBACK=your_fallback_pagespeed_api_key_here

# Groq LLM API Key (Get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Citevana Engine API Key (Get from https://citevana.com)
CITEVANA_API_KEY=your_citevana_api_key_here

# RankNibbler Engine API Key (Get from https://www.ranknibbler.com)
RN_API_KEY=your_ranknibbler_api_key_here
NEXT_PUBLIC_RN_API_KEY=your_ranknibbler_api_key_here

